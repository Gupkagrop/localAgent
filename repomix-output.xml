                self.log(f"[2/7] ❌ Ошибка проверки клавиатурного хука: {e}")
                all_ok = False
                summary_results.append("Клавиша Copilot: Ошибка")

            # 3. Проверка Faster-Whisper и аппаратного ускорения NVIDIA CUDA
