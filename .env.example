# ==============================================================================
# Переменные окружения Antigravity Voice & Vision Assistant (Jarvis)
# Скопируйте этот файл в .env и укажите ваши параметры при необходимости
# ==============================================================================

# Токен Hugging Face для загрузки моделей с ограниченным доступом (опционально)
HF_TOKEN=

# Директория для кэша моделей Hugging Face (по умолчанию: ~/.cache/huggingface/hub)
# HF_HOME=C:\Users\denis\.cache\huggingface

# Уровень логирования (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# Принудительное указание устройства CUDA (по умолчанию: 0)
CUDA_VISIBLE_DEVICES=0
